# ==============================================================================
# Codebook Studio - Environment Configuration
# ==============================================================================

# Session Security Key (Generate a random string for production)
SECRET_KEY=your_super_secret_session_key_here

# ------------------------------------------------------------------------------
# GitHub OAuth 2.0 Credentials
# ------------------------------------------------------------------------------
# 1. Go to: https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Application name: Codebook Studio
# 4. Homepage URL: http://localhost:5050 (or your production URL)
# 5. Authorization callback URL: http://localhost:5050/api/auth/github/callback
# 6. Copy Client ID and generate Client Secret:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
# ------------------------------------------------------------------------------
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create Credentials -> OAuth client ID -> Web application
# 3. Authorized redirect URIs: http://localhost:5050/api/auth/google/callback
# 4. Copy Client ID and Client Secret:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# GitHub Gist Auto-Sync (Persistent SQLite for Render / Railway Free Containers)
# ------------------------------------------------------------------------------
# 1. Go to: https://github.com/settings/tokens
# 2. Generate a new Classic Token with 'gist' permission.
# 3. Paste the token below. The app will auto-create and persist your database
#    to a secret GitHub Gist across restarts and redeployments!
GITHUB_SYNC_TOKEN=
GITHUB_SYNC_GIST_ID=

# ------------------------------------------------------------------------------
# Cloud Database (For Vercel / Render Deployment)
# ------------------------------------------------------------------------------
# Leave empty for local SQLite (backend/data/codebook.db)
# For Supabase / Neon PostgreSQL in production, supply:
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=
