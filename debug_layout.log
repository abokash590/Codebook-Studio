LAYOUT KEYS BEFORE: {'boilerplate_pages': [], 'topics': [{'topic_id': 'data-structures', 'pages': [{'col1': [{'code': 'struct SegTree {\n  int n; vector<ll> t;\n  SegTree(int n): n(n), t(4*n) {}\n  void upd(int p,int v,int x,int lo,int hi){\n    if(lo==hi){ t[x]=v; return; }\n    int m=(lo+hi)/2;\n    p<=m ? upd(p,v,2*x,lo,m)\n         : upd(p,v,2*x+1,m+1,hi);\n    t[x]=t[2*x]+t[2*x+1];\n  }\n  ll qry(int l,int r,int x,int lo,int hi){\n    if(r<lo||hi<l) return 0;\n    if(l<=lo&&hi<=r) return t[x];\n    int m=(lo+hi)/2;\n    return qry(l,r,2*x,lo,m)+qry(l,r,2*x+1,m+1,hi);\n  }\n};', 'complexity': 'O(log n)', 'deleted_at': None, 'formulas': [], 'id': 1, 'kind': 'code', 'language': 'cpp', 'notes': '', 'sort_order': 10, 'subtitle': 'Range sum, point update', 'tested_on': 'Codeforces 1234A', 'title': 'Segment tree', 'topic_id': 'data-structures', 'verified': 1, 'font_size': 9.5}, {'code': 'struct DSU {\n  vector<int> p, sz;\n  DSU(int n): p(n), sz(n,1) {\n    iota(p.begin(),p.end(),0);\n  }\n  int find(int x){\n    return p[x]==x ? x : p[x]=find(p[x]);\n  }\n  bool unite(int a,int b){\n    a=find(a); b=find(b);\n    if(a==b) return false;\n    if(sz[a]<sz[b]) swap(a,b);\n    p[b]=a; sz[a]+=sz[b];\n    return true;\n  }\n};', 'complexity': 'O(a(n))', 'deleted_at': None, 'formulas': [], 'id': 2, 'kind': 'code', 'language': 'cpp', 'notes': '', 'sort_order': 20, 'subtitle': 'Union by size, path compression', 'tested_on': 'Codeforces 25D', 'title': 'DSU', 'topic_id': 'data-structures', 'verified': 1, 'font_size': 9.5}], 'col2': []}]}, {'topic_id': 'graph', 'pages': [{'col1': [{'code': 'vector<ll> dijkstra(int src, vector<vector<pair<int,ll>>>& adj){\n  int n = adj.size();\n  vector<ll> dist(n, LLONG_MAX);\n  priority_queue<pair<ll,int>, vector<pair<ll,int>>, greater<>> pq;\n  dist[src]=0; pq.push({0,src});\n  while(!pq.empty()){\n    auto [d,u]=pq.top(); pq.pop();\n    if(d>dist[u]) continue;\n    for(auto [v,w]: adj[u]){\n      if(dist[u]+w<dist[v]){\n        dist[v]=dist[u]+w;\n        pq.push({dist[v],v});\n      }\n    }\n  }\n  return dist;\n}', 'complexity': 'O((V+E) log V)', 'deleted_at': None, 'formulas': [], 'id': 3, 'kind': 'code', 'language': 'cpp', 'notes': '', 'sort_order': 10, 'subtitle': 'Single source shortest path, non-negative weights', 'tested_on': 'Codeforces 20C', 'title': 'Dijkstra', 'topic_id': 'graph', 'verified': 1, 'font_size': 9.5}], 'col2': []}]}, {'topic_id': 'string', 'pages': [{'col1': [{'code': 'vector<int> prefix_fn(string& s){\n  int n=s.size();\n  vector<int> pi(n);\n  for(int i=1;i<n;i++){\n    int j=pi[i-1];\n    while(j>0 && s[i]!=s[j]) j=pi[j-1];\n    if(s[i]==s[j]) j++;\n    pi[i]=j;\n  }\n  return pi;\n}', 'complexity': 'O(n + m)', 'deleted_at': None, 'formulas': [], 'id': 4, 'kind': 'code', 'language': 'cpp', 'notes': '', 'sort_order': 10, 'subtitle': 'Pattern matching via prefix function', 'tested_on': 'Codeforces 126B', 'title': 'KMP', 'topic_id': 'string', 'verified': 1, 'font_size': 9.5}, {'code': '#include <bits/stdc++.h>\nusing namespace std;\n\n#define ll long long\n\nint main(){\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n\n    int n, m;\n    cin >> n >> m;\n\n    int x[n+1][m+1];\n\n    memset(x, 0, sizeof x);\n\n    for(int i = 1; i <= n; i++){\n        for(int j = 1; j <= m; j++){\n            int v;\n            cin >> v;\n\n            x[i][j] = x[i-1][j] + x[i][j-1] - x[i-1][j-1] + v;\n\n            cout << x[i][j] << " ";\n        }\n        cout << \'\\n\';\n    }\n\n    cout.flush();\n\n    while(1){\n        int r1, c1, r2, c2;\n        cin >> r1 >> c1 >> r2 >> c2;\n\n        int sum = x[r2][c2] - x[r1-1][c2] - x[r2][c1-1] + x[r1-1][c1-1];\n\n        cout << sum << endl;\n    }\n\n    return 0;\n}#include <bits/stdc++.h>', 'complexity': '', 'deleted_at': None, 'formulas': [], 'id': 5, 'kind': 'code', 'language': 'cpp', 'notes': '', 'sort_order': 100, 'subtitle': '', 'tested_on': '', 'title': 'DFDDSF', 'topic_id': 'string', 'verified': 1, 'font_size': 9.5}], 'col2': [{'code